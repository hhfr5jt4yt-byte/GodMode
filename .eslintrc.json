{
	"root": true,
	"env": {
		"browser": true,
		"es2021": true,
		"node": true,
		"jest": true
	},
	"parser": "@typescript-eslint/parser",
	"plugins": ["@typescript-eslint"],
	"parserOptions": {
		"ecmaVersion": "latest",
		"sourceType": "module",
		"ecmaFeatures": {
			"jsx": true
		}
	},
	"ignorePatterns": [
		"node_modules/",
		"release/",
		"dist/",
		"scripts/dll/",
		"coverage/"
	],
	"rules": {
		"no-debugger": "error",
		"no-eval": "error",
		"no-implied-eval": "error",
		"no-new-func": "error",
		"no-unreachable": "error",
		"no-unsafe-finally": "error",
		"valid-typeof": "error",
		"@typescript-eslint/no-explicit-any": "off"
	}
}
